                  <div className="toggle-view-buttons" style={{ marginLeft: 'auto' }}>
                    <button type="button" className={apiPreview.viewMode === 'table' ? 'active' : ''} onClick={() => setApiPreview(prev => ({ ...prev, viewMode: 'table' }))} style={{ marginRight: '4px', padding: '2px 8px', fontSize: '12px' }}>Table</button>
                    <button type="button" className={apiPreview.viewMode === 'json' ? 'active' : ''} onClick={() => setApiPreview(prev => ({ ...prev, viewMode: 'json' }))} style={{ padding: '2px 8px', fontSize: '12px' }}>JSON</button>
