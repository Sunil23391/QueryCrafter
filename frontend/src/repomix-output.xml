                    {headers.map((col) => {
                      const value = isObj ? row[col] : row;
                      return (
                        <td key={col} style={{ padding: '8px 12px', color: '#4b5563' }}>
                          {typeof value === 'object' && value !== null ? JSON.stringify(value) : String(value ?? '')}
