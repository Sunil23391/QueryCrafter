            )}

            {apiImportStatus.text && (
              <div id="apiImportStatus" className={apiImportStatus.className}>
                {apiImportStatus.text}
              </div>
            )}
          </div>
        </div>

        {/* Right Chat History Panel */}
        <div className="right-panel">
          <div id="chatCard" className="card">
            <h2 style={{ marginBottom: '15px' }}>Conversation</h2>

            <div id="chatBox" className="chat-box" ref={chatBoxRef}>
              {chatMessages.map((msg, idx) => (
                <div className={`message ${msg.type}`} key={idx}>
                  {msg.type === 'user' ? (
                    <div className="bubble">{msg.content}</div>
                  ) : (
                    <div>
                      <strong>Generated SQL</strong>
                      <div className="sql">{msg.sql}</div>

                      {/* Local Result Panel inside the assistant dialogue wrapper */}
                      {(msg.previewLoading || msg.previewError || msg.previewData) && (
                        <div className="preview-result" style={{ marginTop: '12px', background: '#f9fafb', padding: '10px', borderRadius: '6px', border: '1px solid #e5e7eb' }}>
                          {msg.previewLoading && <div>Loading preview...</div>}
                          {msg.previewError && <div className="error">{msg.previewError}</div>}
                          {msg.previewData && (
                            <>
                              <div style={{ display: 'flex', alignItems: 'center', marginBottom: '6px' }}>
                                <h4 style={{ margin: 0 }}>Preview Result</h4>
                                <div style={{ marginLeft: 'auto' }}>
                                  <button 
                                    type="button" 
                                    onClick={() => setInlineViewMode(idx, 'table')} 
                                    style={{ marginRight: '4px', padding: '2px 6px', fontSize: '11px', background: msg.viewMode === 'table' ? '#e5e7eb' : '' }}
                                  >Table</button>
                                  <button 
                                    type="button" 
                                    onClick={() => setInlineViewMode(idx, 'json')} 
                                    style={{ padding: '2px 6px', fontSize: '11px', background: msg.viewMode === 'json' ? '#e5e7eb' : '' }}
                                  >JSON</button>
                                </div>
                              </div>
                              <div style={{ fontSize: '11px', color: '#777' }}>Format: {msg.previewFormat}</div>
                              <DataRenderer data={msg.previewData} viewMode={msg.viewMode || 'table'} />
                            </>
                          )}
                        </div>
                      )}

                      <div style={{ marginTop: '8px' }}>
                        <button type="button" onClick={() => previewSqlWithApi(msg.sql, idx)}>
                          Execute Query & Preview
                        </button>
                      </div>

                      <div className="reasoning">💡 {msg.reasoning}</div>
                      <div style={{ fontSize: '12px', color: '#999', marginTop: '8px' }}>
                        Attempts: {msg.attempts}
                      </div>
                    </div>
                  )}
                </div>
              ))}
              {isChatLoading && <div className="loading">Thinking...</div>}
            </div>

            <div style={{ marginTop: '20px' }}>
              <textarea
                id="question"
                placeholder="Ask your SQL question..."
                value={question}
                onChange={(e) => setQuestion(e.target.value)}
                onKeyPress={handleKeyPress}
              />

              <div className="controls">
                <button id="sendBtn" onClick={sendQuestion} disabled={isChatLoading}>
                  Send
                </button>
                <button onClick={resetConversation}>Reset Conversation</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="index.css">
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #f5f7fb;
    font-family: Inter, Arial, sans-serif;
    color: #333;
}

.container {
    width: 95%;
    max-width: 1400px;
    margin: 30px auto;
}

h1 {
    color: #2563eb;
    margin-bottom: 5px;
}

.subtitle {
    color: #666;
    margin-bottom: 25px;
}

.layout {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    transition: all 0.6s ease;
}

.left-panel {
    flex: 1 1 100%;
    max-width: 100%;
    transition: all 0.6s ease;
}

.right-panel {
    flex: 0 0 0;
    max-width: 0;
    opacity: 0;
    transform: translateX(80px);
    overflow: hidden;
    pointer-events: none;
    transition: all 0.6s ease;
}

.layout.session-active .left-panel {
    flex: 0 0 30%;
    max-width: 30%;
}

.layout.session-active .right-panel {
    flex: 0 0 70%;
    max-width: 70%;
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
}

.card {
    background: white;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
}

textarea,
input {
    width: 100%;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 15px;
    font-size: 15px;
}

textarea {
    resize: vertical;
}

#schema {
    height: 280px;
    font-family: monospace;
}

#question {
    height: 90px;
}

button {
    background: #2563eb;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 22px;
    cursor: pointer;
    font-size: 15px;
}

button:hover {
    background: #1d4ed8;
}

button:disabled {
    background: #999;
    cursor: not-allowed;
}

.status {
    margin-top: 10px;
    font-weight: bold;
}

.success {
    color: green;
}

.error {
    color: red;
}

.chat-box {
    height: 550px;
    overflow-y: auto;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: white;
    padding: 20px;
}

.message {
    margin-bottom: 25px;
}

.user {
    text-align: right;
}

.user .bubble {
    display: inline-block;
    background: #2563eb;
    color: white;
    padding: 12px;
    border-radius: 10px;
    max-width: 70%;
}

.assistant {
    text-align: left;
}

.sql {
    background: #111827;
    color: #e5e7eb;
    padding: 15px;
    border-radius: 8px;
    margin-top: 10px;
    white-space: pre-wrap;
    font-family: Consolas, monospace;
}

.reasoning {
    margin-top: 10px;
    color: #666;
    font-style: italic;
}

.preview-result {
    margin-top: 10px;
    padding: 12px;
    border-radius: 8px;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
}

.preview-result pre {
    margin-top: 8px;
    white-space: pre-wrap;
    word-break: break-word;
    font-size: 13px;
}

.controls {
    display: flex;
    gap: 15px;
    margin-top: 20px;
    flex-wrap: wrap;
}

.api-form {
    margin-top: 15px;
    padding-top: 10px;
    border-top: 1px solid #eee;
}

.checkbox-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    margin-bottom: 12px;
}

.checkbox-row input {
    width: auto;
    margin-bottom: 0;
}

.auth-section {
    margin-top: 6px;
    padding: 10px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fafafa;
}

.api-list {
    margin-top: 15px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.api-item {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 12px;
    background: #fafafa;
}

.preview-panel {
    margin-top: 15px;
    padding: 12px;
    background: #f9fafb;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
}

.preview-panel pre {
    white-space: pre-wrap;
    word-break: break-word;
    margin-top: 8px;
}

.hidden {
    display: none;
}

.loading {
    color: #2563eb;
    font-style: italic;
}

@media (max-width: 900px) {
    .layout {
        flex-direction: column;
    }

    .layout.session-active .left-panel,
    .layout.session-active .right-panel {
        flex-basis: auto;
        max-width: 100%;
        width: 100%;
    }

    .right-panel {
        transform: translateY(20px);
    }

    .layout.session-active .right-panel {
        transform: translateY(0);
    }
}
</file>

